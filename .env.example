# Automotive Paint Formula Database Platform
# Environment Configuration Example

# Environment
ENVIRONMENT=development
PROJECT_NAME="Azerbaijan Paint Formula Platform"
API_V1_STR=/api

# Database (PostgreSQL)
# For local Docker: postgresql://paint_user:paint_password@postgres:5432/paint_db
# For local host development: postgresql://paint_user:paint_password@localhost:5432/paint_db
DATABASE_URL=postgresql://paint_user:paint_password@localhost:5432/paint_db
POSTGRES_USER=paint_user
POSTGRES_PASSWORD=paint_password
POSTGRES_DB=paint_db
POSTGRES_PORT=5432

# Security & JWT
# Generate a secure 32+ character key for production: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default Initial Administrator
ADMIN_EMAIL=admin@paintformula.az
ADMIN_PASSWORD=change-this-admin-password-before-startup
ADMIN_FULL_NAME="Master Paint Expert"

# CORS Configuration (comma separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
